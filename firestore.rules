rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticatedOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasValidScheduleCore(data) {
      let requiredFields = [
        'title',
        'completed',
        'date',
        'time',
        'category',
        'priority',
        'repeat'
      ];

      let allowedFields = [
        'title',
        'completed',
        'date',
        'time',
        'category',
        'priority',
        'repeat',
        'repeatEndDate',
        'notificationEnabled',
        'notificationMinutesBefore'
      ];

      return data.keys().hasAll(requiredFields)
        && data.keys().hasOnly(allowedFields)
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.completed is bool
        && data.date is string
        && data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
        && data.time is string
        && data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && data.category in ['업무', '개인', '운동', '공부', '기타']
        && data.priority in ['높음', '보통', '낮음']
        && data.repeat in ['반복 안함', '매일', '매주', '매월', '매년']
        && (!data.keys().hasAny(['repeatEndDate'])
          || (data.repeat != '반복 안함'
            && data.repeatEndDate is string
            && data.repeatEndDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
            && data.repeatEndDate >= data.date));
    }

    // 새 일정의 표준 알림 형태는 두 필드가 모두 없거나 true와 허용 시간이 함께 있는 경우입니다.
    function hasCanonicalNotificationFields(data) {
      return !data.keys().hasAny([
          'notificationEnabled',
          'notificationMinutesBefore'
        ])
        || (data.keys().hasAll([
            'notificationEnabled',
            'notificationMinutesBefore'
          ])
          && data.notificationEnabled is bool
          && data.notificationEnabled == true
          && data.notificationMinutesBefore is int
          && data.notificationMinutesBefore in [0, 5, 10, 30, 60]);
    }

    // 과거 notificationEnabled:false 단독 문서는 다른 필드를 수정할 수 있도록 한시적으로 허용합니다.
    function hasLegacyDisabledNotificationFields(data) {
      return data.keys().hasAny(['notificationEnabled'])
        && !data.keys().hasAny(['notificationMinutesBefore'])
        && data.notificationEnabled is bool
        && data.notificationEnabled == false;
    }

    match /users/{userId} {
      match /schedules/{scheduleId} {
        allow get, list: if isAuthenticatedOwner(userId);

        allow create: if isAuthenticatedOwner(userId)
          && hasValidScheduleCore(request.resource.data)
          && hasCanonicalNotificationFields(request.resource.data);

        allow update: if isAuthenticatedOwner(userId)
          && hasValidScheduleCore(request.resource.data)
          && (hasCanonicalNotificationFields(request.resource.data)
            || (hasLegacyDisabledNotificationFields(resource.data)
              && hasLegacyDisabledNotificationFields(request.resource.data)));

        allow delete: if isAuthenticatedOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
